# Terraform local directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files - may contain secrets
*.tfvars
*.tfvars.json

# Terraform plan files
*.tfplan

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment / secret files
.env
.env.*

# macOS
.DS_Store

# VS Code local settings
.vscode/